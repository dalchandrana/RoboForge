{
  "name": "roboforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roboforge/desktop dev",
    "build": "pnpm -r --filter '!./tools/*' build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "content:check": "tsx tools/content-lint/src/index.ts",
    "content:build": "tsx tools/content-build/src/index.ts",
    "license:audit": "tsx tools/license-audit/src/index.ts",
    "license:check": "pnpm license:audit",
    "knip": "knip",
    "tauri": "pnpm --filter @roboforge/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "knip": "^5.43.6",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
